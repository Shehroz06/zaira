OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
ZAIRA_NUM_THREADS=10
ZAIRA_MIN_RELEVANCE=0.50
ZAIRA_RRF_K=60
ZAIRA_RUNTIME_EMBED_LIMIT=32
ZAIRA_DEBUG_RETRIEVAL=0
# Number of recipe cards returned per query
ZAIRA_RESULT_COUNT=4
# How long Ollama keeps models loaded after a request (avoids cold reloads)
ZAIRA_KEEP_ALIVE=30m
# Use Gemini for structured query-intent parsing (adds an API round-trip per
# request; the local parser is used when false)
ZAIRA_LLM_INTENT=false

LLM_PROVIDER_MODE=auto
GEMINI_ENABLED=true
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
